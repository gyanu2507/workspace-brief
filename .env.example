# development | production | test
# production refuses to start the API without BRIEF_API_KEY
BRIEF_ENV=development

# GitHub (optional locally; required on a public host if source=github)
GITHUB_TOKEN=
GH_TOKEN=

# Optional rewrite of extractive answers. Tests never need these.
GROQ_API_KEY=
OPENAI_API_KEY=

# fixture | github
BRIEF_SOURCE=fixture
BRIEF_REPO=

BRIEF_GITHUB_TIMEOUT=25
BRIEF_GITHUB_RETRIES=3
BRIEF_MEMORY_PATH=.brief-memory.sqlite
BRIEF_TRACE_DIR=traces
BRIEF_LOG_LEVEL=INFO

BRIEF_API_HOST=0.0.0.0
BRIEF_API_PORT=8000

# Set these before exposing the API to anyone else.
BRIEF_API_KEY=
BRIEF_ALLOWED_REPOS=
BRIEF_CORS_ORIGINS=
BRIEF_RATE_LIMIT=60
BRIEF_TRUST_PROXY=
